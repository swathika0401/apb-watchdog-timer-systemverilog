class apb_generator;

    mailbox gen2drv;

    function new(mailbox m);
        gen2drv = m;
    endfunction


    task run();

        apb_txn t;


        // -----------------------------
        // LOAD = 5
        // -----------------------------

        t = new();

        t.addr  = 8'h00;
        t.data  = 5;
        t.write = 1;

        gen2drv.put(t);


        // -----------------------------
        // CONTROL
        // INTEN = 1
        // RESEN = 1
        // data = 3
        // -----------------------------

        t = new();

        t.addr  = 8'h04;
        t.data  = 3;
        t.write = 1;

        gen2drv.put(t);


        // -----------------------------
        // READ COUNT
        // -----------------------------

        #40;

        t = new();

        t.addr  = 8'h08;
        t.data  = 0;
        t.write = 0;

        gen2drv.put(t);


        // -----------------------------
        // WAIT FOR INTERRUPT
        // -----------------------------

        #100;


        // -----------------------------
        // REFRESH
        // -----------------------------

        t = new();

        t.addr  = 8'h0C;
        t.data  = 1;
        t.write = 1;

        gen2drv.put(t);


        // -----------------------------
        // READ COUNT AFTER REFRESH
        // -----------------------------

        #30;

        t = new();

        t.addr  = 8'h08;
        t.data  = 0;
        t.write = 0;

        gen2drv.put(t);


    endtask

endclass
